// Phase 5: accounts, saved games, Glicko-2 ratings. See SPEC.md Feature 5.
generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  /// Lowercased username: what uniqueness and login are checked against.
  usernameKey  String   @unique
  /// Username as the player typed it, shown everywhere.
  username     String
  /// Null for accounts created with Google sign-in, which have no password.
  passwordHash String?
  createdAt    DateTime @default(now())

  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  games          Game[]
  ratings        Rating[]
  ratingEvents   RatingEvent[]
  puzzleAttempts PuzzleAttempt[]
  state          UserState[]

  coachInvites     CoachInvite[]   @relation("InviteStudent")
  coachLinks       CoachLink[]     @relation("LinkCoach")
  studentLinks     CoachLink[]     @relation("LinkStudent")
  commentsWritten  CoachComment[]  @relation("CommentCoach")
  commentsReceived CoachComment[]  @relation("CommentStudent")
  homeworkSet      Homework[]      @relation("HomeworkCoach")
  homeworkGiven    Homework[]      @relation("HomeworkStudent")
}

/// A sign-in provider identity (Google) linked to a user. Linked only by signing in with it,
/// or by linking it while signed in: never by matching email addresses.
model OAuthAccount {
  id             String   @id @default(cuid())
  /// 'google'
  provider       String
  /// The provider's stable user id (Google's "sub"), not the email.
  providerUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Shown on the account page only; never used to match accounts.
  email          String?
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model Session {
  /// sha256 of the cookie token; the token itself is never stored.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model Game {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// GameRecord.id from the browser; a re-upload of the same game replaces it.
  clientId     String
  /// The browser's GameRecord, stored unchanged (review included when there is one).
  record       Json
  result       String
  /// Side the account holder played; null when both sides were people at one screen.
  userColor    String?
  opponentName String
  /// Rating category ('bullet' | 'blitz' | 'rapid' | 'classical') when the game was rated.
  category     String?
  rated        Boolean  @default(false)
  playedAt     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratingEvent RatingEvent?
  comments    CoachComment[]

  @@unique([userId, clientId])
  @@index([userId, playedAt])
}

model Rating {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String
  rating     Float
  rd         Float
  volatility Float
  games      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([userId, category])
}

/// One per rated game: what the rating was before and after. The profile graph reads these.
model RatingEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId       String   @unique
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category     String
  ratingBefore Float
  ratingAfter  Float
  rdAfter      Float
  createdAt    DateTime @default(now())

  @@index([userId, category, createdAt])
}

/// A player's FIRST attempt at a puzzle: the only one that moves their puzzle rating (the Rating row
/// with category 'puzzle'). Later attempts at the same puzzle are not stored.
model PuzzleAttempt {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lichess puzzle id (public/puzzles/puzzles.json).
  puzzleId     String
  solved       Boolean
  ratingBefore Float
  ratingAfter  Float
  createdAt    DateTime @default(now())

  @@unique([userId, puzzleId])
  @@index([userId, createdAt])
}

/// Preferences and training state that follow the account (src/sync/keys.ts lists the keys).
/// One row per localStorage key; `value` is what the browser sends, merged by src/sync/merge.ts.
model UserState {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A localStorage key from the allowlist, e.g. 'rookery.boardTheme'.
  key       String
  value     Json
  /// When the value last changed on the device that set it (capped at the server's clock).
  updatedAt DateTime

  @@id([userId, key])
}

/// A student's one-use invite code for a coach. Only the code's sha256 is stored. A new code replaces
/// the student's unused ones; redeeming sets usedAt (a used or expired code links nobody).
model CoachInvite {
  /// sha256 of the normalised code.
  id        String    @id
  studentId String
  student   User      @relation("InviteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([studentId])
}

/// An active coach–student link. Unlinking (either side) deletes the row; every coach endpoint checks it.
model CoachLink {
  coachId   String
  coach     User     @relation("LinkCoach", fields: [coachId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("LinkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([coachId, studentId])
  @@index([studentId])
}

/// A coach's comment on one of a student's saved games, optionally on one ply. Stays on the game after an
/// unlink (the student keeps it; the coach can no longer read the game).
model CoachComment {
  id        String    @id @default(cuid())
  coachId   String
  coach     User      @relation("CommentCoach", fields: [coachId], references: [id], onDelete: Cascade)
  studentId String
  student   User      @relation("CommentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// 1-based ply the comment is about; null for the whole game.
  ply       Int?
  body      String
  /// When the student saw it; null = unread.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([gameId, createdAt])
  @@index([studentId, readAt])
}

/// Puzzle homework a coach set a student: positions (solver to move) with solution lines.
model Homework {
  id        String            @id @default(cuid())
  coachId   String
  coach     User              @relation("HomeworkCoach", fields: [coachId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation("HomeworkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  /// HomeworkItem[] (src/api/types.ts), validated on create.
  items     Json
  dueAt     DateTime?
  createdAt DateTime          @default(now())
  attempts  HomeworkAttempt[]

  @@index([studentId, createdAt])
  @@index([coachId, studentId])
}

/// Every attempt the student makes at one homework position (the coach sees attempts and solved).
model HomeworkAttempt {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  /// Index into Homework.items.
  item       Int
  solved     Boolean
  createdAt  DateTime @default(now())

  @@index([homeworkId, item])
}
