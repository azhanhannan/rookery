{
  "name": "rookery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-stockfish.mjs && node scripts/fetch-maia.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-stockfish.mjs && node scripts/fetch-maia.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:bots": "vitest run -c vitest.match.config.ts",
    "postinstall": "prisma generate",
    "server": "tsx watch server/src/main.ts",
    "server:start": "tsx server/src/main.ts",
    "test:server": "vitest run -c vitest.server.config.ts",
    "db:studio": "prisma studio --port 5555"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "chess.js": "^1.4.0",
    "fastify": "^5.12.7",
    "glicko2": "^1.2.1",
    "onnxruntime-web": "1.30.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "stockfish": "^19.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
