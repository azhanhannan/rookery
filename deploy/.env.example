# Copy to /opt/rookery/.env on the droplet (chmod 600). Never commit the real one.

# Public hostname, proxied (orange cloud) in Cloudflare.
DOMAIN=chess.example.com

# GitHub user or org that owns the images, lowercase: ghcr.io/<this>/rookery-api
GHCR_OWNER=azhanhannan

# Generate with: openssl rand -hex 24   (hex only: it goes into a URL unescaped)
POSTGRES_PASSWORD=

# Google sign-in: leave empty to hide "Continue with Google". The redirect URI is set from DOMAIN in compose.yaml:
#   https://<DOMAIN>/api/auth/google/callback  (add it to the Google client's Authorized redirect URIs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set by deploy.sh to the image tag it deployed (the commit SHA). Leave it to the script.
IMAGE_TAG=latest
