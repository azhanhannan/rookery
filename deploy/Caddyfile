{
	# The Cloudflare-only check below must run before any handle block; by default Caddy runs abort after them.
	order abort before handle
}

# Rookery behind Cloudflare (proxied, SSL mode "Full (strict)"). The certificate is a Cloudflare Origin
# Certificate mounted from /opt/rookery/certs, so there is no ACME and nothing to renew. See docs/DEPLOY.md.

# Only Cloudflare may talk to this server on 80/443. A request straight to the droplet's IP would skip
# Cloudflare's WAF, rate limits and DDoS protection, so it is dropped without a reply. Caddy sees the real peer
# address here (nothing sits in front of it but Cloudflare), so remote_ip is the Cloudflare edge.
# Ranges: https://www.cloudflare.com/ips (fetched 12 Nov 2026). They change rarely; if Cloudflare adds a range,
# visitors routed through it get dropped connections, so re-check the list when something looks unreachable.
(cloudflare_only) {
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @direct
}

{$DOMAIN} {
	import cloudflare_only
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# no other site may show Rookery inside a frame (clickjacking)
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		reverse_proxy api:5181
	}

	handle {
		root * /srv

		# Vite's hashed bundles never change under the same name.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Engines, Maia model (~44 MB), boards and pieces: unhashed names, so a week, not forever.
		@static path /maia/* /ort/* /stockfish/* /boards/* /pieces/* /puzzles/*
		header @static Cache-Control "public, max-age=604800"

		@html path / /index.html
		header @html Cache-Control "no-cache"

		file_server
	}
}

# Papan Tulis (personal, static PWA) shares this droplet. Its files are not in this image: they sit in
# /opt/rookery/sites/buku, uploaded by tools/deploy.sh in the buku repo, so deploying it never restarts Rookery.
# `current` is a symlink to one release folder, swapped atomically. The same origin cert covers *.runcodecloud.com.
{$BUKU_DOMAIN:buku.runcodecloud.com} {
	import cloudflare_only
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Private classroom use: keep it out of search engines.
		X-Robots-Tag "noindex, nofollow"
		# no framing; and the page never needs the camera, microphone or location
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	root * /sites/buku/current

	# The service worker does its own caching. The browser and Cloudflare must always revalidate these,
	# or the "Versi baharu sedia" banner shows up late.
	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"

	@static path /fonts/* /*.png /icon.svg
	header @static Cache-Control "public, max-age=604800"

	file_server
}

# Cendekia DMJ (Laravel prototype for the DMJ alumni team) shares this droplet. It is its own Compose
# project in /home/deploy/cendekia (repo azhanhannan/cendekia-dmj) and joins this stack's network with the alias
# "cendekia", publishing no ports. If it is down, only this hostname answers 502; Rookery is unaffected.
{$CENDEKIA_DOMAIN:cendekia.runcodecloud.com} {
	import cloudflare_only
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Prototype with sample data: keep it out of search engines until it goes live for real.
		X-Robots-Tag "noindex, nofollow"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy cendekia:8080 {
		# Only Cloudflare reaches this block (cloudflare_only), and Cloudflare sets CF-Connecting-IP itself,
		# so it is safe to hand Laravel the visitor's real IP (login throttling keys on it).
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}
